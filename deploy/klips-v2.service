[Unit]
Description=Klips Concept Product Finder v2
After=network.target

[Service]
Type=simple
User=klips
Group=klips
WorkingDirectory=/var/www/klips-urun-bulucu-v2
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/var/cache/klips/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=OMP_NUM_THREADS=2
ExecStart=/var/www/klips-urun-bulucu/venv/bin/gunicorn --workers 1 --threads 2 --timeout 180 --bind 127.0.0.1:5002 app:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
